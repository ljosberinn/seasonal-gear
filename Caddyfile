:{$PORT:80} {
    root * /app/public
    encode zstd gzip

    # Vite fingerprints these file names, so browsers can keep them across deployments.
    @fingerprinted path /build/assets/*
    header @fingerprinted Cache-Control "public, max-age=31536000, immutable"

    @static path /build/* /favicon.ico /logo.jpg /robots.txt
    header @static Vercel-CDN-Cache-Control "max-age=31536000"
    header @static ?Cache-Control "public, max-age=86400"

    php_server {
        try_files {path} index.php
    }
}
