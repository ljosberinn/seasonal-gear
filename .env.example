APP_NAME="Seasonal Gear"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# There's no database and nothing is cached or queued. Sessions are never persisted so the CDN can cache pages.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
